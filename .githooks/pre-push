#!/usr/bin/env bash
set -euo pipefail

echo "[pre-push] Running local build check…"

BIN="./node_modules/.bin"

if [ ! -d node_modules ]; then
  echo "[pre-push] Installing deps…"
  npm ci
fi

# Run unit tests and a production build. This mirrors what CI does and
# what Vercel runs server-side.
npm test --silent
npm run -s build

echo "[pre-push] Tests + build ok. Proceeding with push."

