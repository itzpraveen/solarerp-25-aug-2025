NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Cron secret for /api/cron/daily
CRON_SECRET=
# If you rely on Vercel Cron (GET), set to 1 to trust x-vercel-cron header
CRON_ALLOW_VERCEL_HEADER=

# Optional for local seeds
SEED_TENANT_ID=

# PDF Malayalam font embedding (optional)
# Either set a full URL to a TTF (e.g., https://your-domain/fonts/NotoSansMalayalam-Regular.ttf)
NEXT_PUBLIC_ML_FONT_URL=
# Or embed the base64 of the TTF directly (large; prefer URL)
PDF_ML_FONT_BASE64=

# Distributed rate limiting (recommended for production)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
