NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
NEXT_PUBLIC_ALLOW_SELF_SIGNUP=0
ALLOW_SELF_SIGNUP=0
DATABASE_URL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=

# Cron secret for /api/cron/daily
CRON_SECRET=

# Optional for local seeds
SEED_TENANT_ID=
SEED_CT_METER_KW=8
SEED_CABLE_M_PER_KW=10

# PDF Malayalam font embedding (optional)
# Either set a full URL to a TTF (e.g., https://your-domain/fonts/NotoSansMalayalam-Regular.ttf)
NEXT_PUBLIC_ML_FONT_URL=
# Or embed the base64 of the TTF directly (large; prefer URL)
PDF_ML_FONT_BASE64=
# Set to a remotely hosted chromium min pack tar for serverless fallback
# Example: https://your-bucket/chromium-v127-pack.tar
CHROMIUM_MIN_PACK_URL=

# Enable verbose PDF logs on server for troubleshooting
LOG_PDF_DEBUG=

# Base URL resolution (pick one; optional)
# If set, used by helpers when constructing absolute links
NEXT_PUBLIC_BASE_URL=
# Alternative site URL var supported by getBaseUrl()
NEXT_PUBLIC_SITE_URL=
