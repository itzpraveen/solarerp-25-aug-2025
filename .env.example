NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# WhatsApp Cloud API
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Cron secret for /api/cron/daily
CRON_SECRET=

# Optional for local seeds
SEED_TENANT_ID=
SEED_CT_METER_KW=8
SEED_CABLE_M_PER_KW=10

# PDF Malayalam font embedding (optional)
# Either set a full URL to a TTF (e.g., https://your-domain/fonts/NotoSansMalayalam-Regular.ttf)
NEXT_PUBLIC_ML_FONT_URL=
# Or embed the base64 of the TTF directly (large; prefer URL)
PDF_ML_FONT_BASE64=
# Set to a remotely hosted chromium min pack tar for serverless fallback
# Example: https://your-bucket/chromium-v127-pack.tar
CHROMIUM_MIN_PACK_URL=
# Alternative full pack URL (optional)
CHROMIUM_PACK_URL=

# Enable verbose PDF logs on server for troubleshooting
LOG_PDF_DEBUG=

# Base URL resolution (pick one; optional)
# If set, used by helpers when constructing absolute links
NEXT_PUBLIC_BASE_URL=
# Alternative site URL var supported by getBaseUrl()
NEXT_PUBLIC_SITE_URL=

# Sign-up mode flags (optional)
# When set, magic-link login may auto-create users at Supabase (client-side).
# Server remains invite-only by default unless ALLOW_SELF_SIGNUP is set.
NEXT_PUBLIC_ALLOW_SELF_SIGNUP=
ALLOW_SELF_SIGNUP=

# Username/password auth (no email dependency)
NEXT_PUBLIC_AUTH_USERNAME_DOMAIN=erp.renewg.in
# Server-side fallback if you prefer a non-public var
AUTH_USERNAME_DOMAIN=
# Default password for admin-created users (set in prod envs)
DEFAULT_USER_PASSWORD=
# Enables /api/ops/backfill-profiles in production when explicitly set to 1
ENABLE_PROFILE_BACKFILL=
# Enables bulk all-missing profile backfill only when explicitly set to 1
ENABLE_PROFILE_BACKFILL_ALL_MISSING=

# Business tunables (optional)
NEXT_PUBLIC_DEPOSIT_DUE_DAYS=7
RATE_LIMIT_PDF_PER_MIN=5
RATE_LIMIT_WHATSAPP_PER_MIN=10
KSEB_FOLLOWUP_DAYS=7,14

# Optional: Upstash Redis REST credentials for production rate limiting
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Optional: Outbound email webhook for notifications
# NOTIFY_EMAIL_WEBHOOK_URL=
# NOTIFY_EMAIL_WEBHOOK_TOKEN=

# Leads importer guardrails (optional)
LEADS_IMPORT_MAX_BYTES=2097152

# Note: Self-signup flags are not required. The first user is auto-provisioned
# by DB trigger, and all other users should be invited by an admin.
